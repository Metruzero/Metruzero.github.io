---
// One template for every project page.
// The [id] in the file name is a placeholder: Astro creates one page
// per project, at /projects/<id>, using the list from getStaticPaths().
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tags from '../../components/Tags.astro';

// Runs once at build time: "which pages should exist?"
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, date, cover, coverAlt, tags, role, team, duration, links } =
  project.data;

// Turns the Markdown body into HTML we can place on the page.
const { Content } = await render(project);

// Only show the details this project actually has.
const details = [
  { label: 'Role', value: role },
  { label: 'Team', value: team },
  { label: 'Time', value: duration },
  {
    label: 'Finished',
    value: date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }),
  },
].filter((detail) => detail.value);
---

<BaseLayout title={title} description={summary}>
  <article>
    <a href="/projects" class="back">← All projects</a>

    <header>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>

      <dl class="details">
        {
          details.map((detail) => (
            <div>
              <dt>{detail.label}</dt>
              <dd>{detail.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="page-tags">
        <Tags tags={tags} />
      </div>

      {
        (links.play || links.github) && (
          <div class="links">
            {links.play && <a href={links.play}>Play it on itch.io ↗</a>}
            {links.github && <a href={links.github}>Source on GitHub ↗</a>}
          </div>
        )
      }
    </header>

    {cover && <Image src={cover} alt={coverAlt ?? ''} class="cover" loading="eager" />}

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 46rem;
    margin-inline: auto;
  }

  header {
    margin-bottom: 2.5rem;
  }

  .back {
    display: inline-block;
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .summary {
    color: var(--muted);
    font-size: 1.15rem;
    margin-bottom: 1.5rem;
  }

  /* Details: a row of label/value pairs */
  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 0 0 1.25rem;
    padding: 1rem 0;
    border-block: 1px solid var(--border);
  }

  dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: lowercase;
  }

  dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .page-tags {
    margin-bottom: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .cover {
    width: 100%;
    height: auto;
    margin-bottom: 2.5rem;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  /*
    Styles for the Markdown content. The HTML inside <Content /> is
    generated, not written in this file, so these rules use :global()
    to reach past Astro's automatic style scoping.
  */
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 0.75rem;
  }

  .prose :global(p),
  .prose :global(ol),
  .prose :global(ul) {
    margin: 0 0 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin-block: 1rem;
    border-radius: 12px;
    border: 1px solid var(--border);
  }
</style>
